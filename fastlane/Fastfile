default_platform(:ios)

platform :ios do
  desc "Create signing certificates if needed, build the app and upload it to TestFlight"
  lane :build_upload do
    setup_ci

    bundle_id = ENV["BUNDLE_ID"]
    team_id = ENV["TEAMID"]
    owner = ENV["GITHUB_REPOSITORY_OWNER"]

    # Accept the .p8 key with or without its BEGIN/END lines, and with stray spaces.
    key = ENV["FASTLANE_KEY"].to_s.gsub("\\n", "\n").strip
    unless key.include?("BEGIN PRIVATE KEY")
      body = key.gsub(/\s+/, "").scan(/.{1,64}/).join("\n")
      key = "-----BEGIN PRIVATE KEY-----\n#{body}\n-----END PRIVATE KEY-----"
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"].to_s.strip,
      issuer_id: ENV["FASTLANE_ISSUER_ID"].to_s.strip,
      key_content: key,
      is_key_content_base64: false,
      in_house: false
    )

    # Certificates and profiles live, encrypted, in your private Match-Secrets repository.
    match(
      type: "appstore",
      app_identifier: bundle_id,
      team_id: team_id,
      api_key: api_key,
      git_url: "https://github.com/#{owner}/Match-Secrets",
      git_basic_authorization: Base64.strict_encode64("#{owner}:#{ENV['GH_PAT']}"),
      storage_mode: "git",
      readonly: false
    )

    profile = ENV["sigh_#{bundle_id}_appstore_profile-name"]

    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      targets: ["Runner"],
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      export_options: {
        provisioningProfiles: { bundle_id => profile }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
