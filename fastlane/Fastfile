default_platform(:ios)

platform :ios do
  desc "Create signing certificates if needed, build the app and upload it to TestFlight"
  lane :build_upload do
    setup_ci

    bundle_id = ENV["BUNDLE_ID"]
    team_id = ENV["TEAMID"]
    owner = ENV["GITHUB_REPOSITORY_OWNER"]

    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_content: ENV["FASTLANE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    widget_id = "#{bundle_id}.BGWidget"
    # Plain Ruby here runs inside the fastlane folder, hence "..".
    has_widget = File.exist?("../ios/BGWidget/Info.plist")

    # App IDs (the app, e.g. Monitor Glucose Plus, and its widget): created the first time.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    unless Spaceship::ConnectAPI::BundleId.find(bundle_id)
      UI.message("Creating the App ID #{bundle_id}")
      Spaceship::ConnectAPI::BundleId.create(name: ENV["APP_NAME"] || "Monitor Glucose", identifier: bundle_id, platform: "IOS")
    end
    if has_widget
      unless Spaceship::ConnectAPI::BundleId.find(widget_id)
        UI.message("Creating the App ID #{widget_id}")
        Spaceship::ConnectAPI::BundleId.create(name: "Monitor Glucose Widget", identifier: widget_id, platform: "IOS")
      end
    end
    ids = has_widget ? [bundle_id, widget_id] : [bundle_id]

    # Certificates and profiles live, encrypted, in your private Match-Secrets repository.
    match(
      type: "appstore",
      app_identifier: ids,
      team_id: team_id,
      api_key: api_key,
      git_url: "https://github.com/#{owner}/Match-Secrets",
      git_basic_authorization: Base64.strict_encode64("#{owner}:#{ENV['GH_PAT']}"),
      storage_mode: "git",
      readonly: false
    )

    profile = ENV["sigh_#{bundle_id}_appstore_profile-name"]

    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      targets: ["Runner"],
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )

    profiles = { bundle_id => profile }
    if has_widget
      widget_profile = ENV["sigh_#{widget_id}_appstore_profile-name"]
      update_code_signing_settings(
        path: "ios/Runner.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        targets: ["BGWidget"],
        bundle_identifier: widget_id,
        code_sign_identity: "Apple Distribution",
        profile_name: widget_profile
      )
      profiles[widget_id] = widget_profile
    end

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      export_options: {
        provisioningProfiles: profiles
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
