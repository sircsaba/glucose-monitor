{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glucose-server",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glucose-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Copies from Nightscout every minute (does nothing if NIGHTSCOUT_URL is empty).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SITE_NAME": "My Glucose",
    "UNITS": "mmol",
    "NIGHTSCOUT_URL": "",
    "KEEP_DAYS": "365"
  }
}
